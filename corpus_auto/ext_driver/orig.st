FUNCTION_BLOCK FB_Driver
VAR_INPUT
	xToggle : BOOL;
END_VAR
VAR_INPUT
	SET0 : BOOL;
	IN : BOOL;
	RST : BOOL;
END_VAR
VAR_OUTPUT
	Q : BOOL;
END_VAR
VAR
	off : TON;
	edge: BOOL;
END_VAR
IF off.Q THEN Q := FALSE; END_IF;
IF RST THEN
	Q := FALSE;
ELSIF SET0 THEN
	Q := TRUE;
ELSIF IN AND NOT edge THEN
	IF xToggle THEN Q := NOT Q; ELSE Q := TRUE; END_IF;
END_IF;
edge := IN;
IF T#500MS > T#0S THEN off(IN := Q, PT := T#500MS); END_IF;
END_FUNCTION_BLOCK
